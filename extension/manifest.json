{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "key": "",
  "name": "Mergulhe — foco e oceano",
  "version": "1.1.0",
  "description": "Cronômetro de foco com um oceano virtual que ganha vida conforme você se concentra.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications", "identity"],
  "host_permissions": ["https://ukzixtqsdybeqrwsybqt.supabase.co/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mergulhe: foco rápido"
  },
  "background": {
    "service_worker": "generated/background.js",
    "type": "module"
  }
}
